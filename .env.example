# ====================================================================
# Yonas Mobile SMS Sender — Environment Configuration
# ====================================================================

# 1. Database Configuration (Supabase PostgreSQL / Hosted Postgres)
# --------------------------------------------------------------------
# Connection pooled connection string (used by app runtime on Vercel / serverless)
DATABASE_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true&sslmode=require&connect_timeout=30&pool_timeout=30"

# Direct / pooler connection string for Prisma migrations
DIRECT_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true&sslmode=require&connect_timeout=30&pool_timeout=30"

# 2. AfroMessage SMS Provider Configuration
# --------------------------------------------------------------------
# Your AfroMessage API Token generated from https://app.afromessage.com/
AFROMESSAGE_API_KEY=your_afromessage_api_bearer_token_here

# The registered, approved sender name for Yonas Mobile (e.g. YonasMobile).
# If omitted or unapproved, defaults to 'AfroMessage'
AFROMESSAGE_SENDER_NAME=YonasMobile

# System identifier ID if subscribed to multiple short codes/identifiers (optional)
# AFROMESSAGE_IDENTIFIER_ID=your_identifier_id_here

# Delivery progress callback URL (configured on AfroMessage or passed dynamically)
# AFROMESSAGE_CALLBACK_URL=https://your-domain.com/api/webhooks/afromessage?secret=your_webhook_secret_token

# Secret query token to authenticate incoming delivery callbacks
AFROMESSAGE_WEBHOOK_SECRET=your_afromessage_webhook_secret_token

# 3. Internal Access Protection
# --------------------------------------------------------------------
# Set an internal secret access key to protect the dashboard and sending endpoints
# against unauthorized public requests.
# Authorized employees enter this key once per session in the application interface.
APP_ACCESS_KEY=your_internal_company_access_secret_here

# 4. Campaign & Tariff Configuration (Optional)
# --------------------------------------------------------------------
# SMS tariff per standard segment (in ETB, e.g., 0.35 ETB)
SMS_COST_PER_SEGMENT=0.35
SMS_CURRENCY=ETB

# Default country calling code for local numbers (defaults to +251 for Ethiopia)
DEFAULT_COUNTRY_CODE=+251
