# ====================================================================
# Yonas Mobile SMS Sender — Environment Configuration
# ====================================================================

# 1. AfroMessage SMS Provider Configuration
# --------------------------------------------------------------------
# Your AfroMessage API Token generated from https://app.afromessage.com/
AFROMESSAGE_API_KEY=your_afromessage_api_bearer_token_here

# The registered, approved sender name for Yonas Mobile (e.g. YonasMobile).
# If omitted or unapproved, defaults to 'AfroMessage'
AFROMESSAGE_SENDER_NAME=YonasMobile

# System identifier ID if subscribed to multiple short codes/identifiers (optional)
# AFROMESSAGE_IDENTIFIER_ID=your_identifier_id_here

# Delivery progress callback URL (optional)
# AFROMESSAGE_CALLBACK_URL=https://your-domain.com/api/afromessage/callback

# 2. Internal Access Protection
# --------------------------------------------------------------------
# Set an internal secret access key to protect the sending endpoint
# against unauthorized public requests.
# Authorized employees must enter this key in the application interface.
APP_ACCESS_KEY=your_internal_company_access_secret_here

# 3. Campaign & Tariff Configuration (Optional)
# --------------------------------------------------------------------
# SMS tariff per standard segment (in ETB, e.g., 0.35 ETB)
SMS_COST_PER_SEGMENT=0.35
SMS_CURRENCY=ETB

# Default country calling code for local numbers (defaults to +251 for Ethiopia)
DEFAULT_COUNTRY_CODE=+251
