generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum CampaignStatus {
  DRAFT
  SENDING
  COMPLETED
  PARTIALLY_FAILED
  FAILED
  INTERRUPTED
}

enum RecipientStatus {
  PENDING
  SUBMITTED
  DELIVERED
  FAILED
  TIMEOUT_UNCONFIRMED
}

model MessageTemplate {
  id         String   @id @default(cuid())
  name       String
  body       String   @db.Text
  isArchived Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([isArchived])
  @@index([createdAt])
}

model Campaign {
  id               String         @id @default(cuid())
  name             String
  originalFilename String?
  messageTemplate  String         @db.Text
  status           CampaignStatus @default(DRAFT)
  isArchived       Boolean        @default(false)
  totalRecipients  Int            @default(0)
  validRecipients  Int            @default(0)
  submittedCount   Int            @default(0)
  deliveredCount   Int            @default(0)
  failedCount      Int            @default(0)
  pendingCount     Int            @default(0)
  estimatedCost    Float?
  actualCost       Float?
  startedAt        DateTime?
  completedAt      DateTime?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  recipients CampaignRecipient[]
  batches    CampaignBatch[]

  @@index([status])
  @@index([isArchived])
  @@index([createdAt])
}

model CampaignBatch {
  id              String         @id @default(cuid())
  campaignId      String
  campaign        Campaign       @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  batchNumber     Int            @default(1)
  name            String?
  messageText     String         @db.Text
  status          CampaignStatus @default(DRAFT)
  totalRecipients Int            @default(0)
  validRecipients Int            @default(0)
  submittedCount  Int            @default(0)
  deliveredCount  Int            @default(0)
  failedCount     Int            @default(0)
  pendingCount    Int            @default(0)
  estimatedCost   Float?
  actualCost      Float?
  startedAt       DateTime?
  completedAt     DateTime?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  recipients CampaignRecipient[]

  @@index([campaignId])
  @@index([status])
  @@index([createdAt])
}

model CampaignRecipient {
  id                String          @id @default(cuid())
  campaignId        String
  campaign          Campaign        @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  batchId           String?
  batch             CampaignBatch?  @relation(fields: [batchId], references: [id], onDelete: SetNull)
  recipientName     String?
  phone             String
  maskedPhone       String
  status            RecipientStatus @default(PENDING)
  providerMessageId String?
  submittedAt       DateTime?
  deliveredAt       DateTime?
  failureReason     String?         @db.Text
  retryCount        Int             @default(0)
  providerStatus    String?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  @@unique([campaignId, phone])
  @@index([campaignId])
  @@index([batchId])
  @@index([providerMessageId])
  @@index([status])
  @@index([createdAt])
}
